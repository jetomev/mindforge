#!/usr/bin/env bash
# mindForge -- orientation and closeout for working with an AI companion.
#   mindforge brief [--headline]   what is true right now
#   mindforge wrap                 close the session (step 5)
#   mindforge drift "<note>"       log a drift observation (step 5)
set -uo pipefail

# Paths come from config, never from this file -- it is published.
# ~/.config/mindforge/config is local and gitignored; see config.example.
[ -r "$HOME/.config/mindforge/config" ] && . "$HOME/.config/mindforge/config"

VERSION="0.1.4"
STATE="${MINDFORGE_STATE:-$HOME/.claude/state}"
PROJECTS="${MINDFORGE_PROJECTS:-$HOME/Programs}"   # colon-separated, PATH-style
# Claude Code encodes the working directory into the memory path: / becomes -
MEM="${MINDFORGE_MEMORY:-$HOME/.claude/projects/$(echo "$HOME" | tr '/' '-')/memory}"
VAULT="${MINDFORGE_VAULT:-}"
REMOTE="$STATE/remote.json"

B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; O=$'\033[0m'
# Hook output is consumed as plain text, not rendered -- escapes would be noise.
[ -t 1 ] || [ -n "${FORCE_COLOUR:-}" ] || { B=""; D=""; G=""; Y=""; R=""; O=""; }

# One malformed row must not take the whole headline down with it. v0.1.0
# fed date(1) straight into arithmetic: a single bad field printed a raw
# shell error where the briefing should be. Unknown is a legal answer here.
# F-11 · "dirty" is a fact, not information.
# A fresh session was told `2 dirty` and nothing else, so it offered to build
# a release that was already written and tested in the working tree. One
# untracked stray and 89 lines of finished work looked identical. Report the
# shape of the change: files touched, lines in/out, untracked count.
# F-33 · One root was a silent blind spot, and the quiet part was the headline.
# MINDFORGE_PROJECTS held a SINGLE directory, so every repo outside it was
# invisible -- not merely missing from the Projects table, but uncounted by the
# rot line, which printed "19 repos clean - nothing unpushed" while two commits
# sat unpushed under a second root and a third repo had no remote at all.
# A health line that cannot see a repo must not speak for it.
# Roots are a PATH-style colon-separated list now, and -- the load-bearing half
# -- every repo the queue names is scanned whether or not it sits under a root.
# That is what makes the blind spot impossible rather than merely wider.
proj_roots() { printf '%s\n' "$PROJECTS" | tr ':' '\n' | grep -v '^$'; }

# Resolve a queue name to a directory. The name may carry a path, because a
# sub-project inside a monorepo is `platform/store-two` -- so the first root
# that HAS it wins, and no name is assumed to live under the first root.
proj_dir() {
  local root
  while IFS= read -r root; do
    [ -d "$root/$1" ] && { printf '%s' "$root/$1"; return 0; }
  done < <(proj_roots)
  return 1
}

# The repository GOVERNING a directory, which is not always the directory.
# A sub-project inside a monorepo carries no .git of its own; calling it
# "absent" in red would be false. Its work is tracked -- by the repo above it.
governing_repo() { git -C "$1" rev-parse --show-toplevel 2>/dev/null; }

# W-9 · queue.md is hand-written, and on Windows hand-written means CRLF.
# Every reader split on tabs and kept the \r, so the last column of every
# row -- the reference -- read as "-\r", and each deliberate "-" opt-out was
# reported as "could not reach the tracker". The last name on the @priority
# line lost its rank the same way, silently. One reader for every consumer,
# so a line ending cannot mean one thing to one check and another to the next.
queue_lines() { tr -d '\r' < "$STATE/queue.md"; }

# Every repo worth reporting on: all repos directly under any root, PLUS the
# governing repo of every project the queue names. Deduplicated.
all_repos() {
  local root d proj g
  { while IFS= read -r root; do
      for d in "$root"/*/.git; do [ -d "$d" ] && printf '%s\n' "${d%/.git}"; done
    done < <(proj_roots)
    if [ -r "$STATE/queue.md" ]; then
      while IFS=$'\t' read -r proj _; do
        case "$proj" in \#*|@*|"") continue;; esac
        d=$(proj_dir "$proj") || continue
        g=$(governing_repo "$d") && [ -n "$g" ] && printf '%s\n' "$g"
      done < <(queue_lines)
    fi
  } | sort -u
}

# F-32, second visit · printf field widths count BYTES; a queue line carrying
# an em-dash is 3 bytes for 1 visible character, so every column to its right
# slides. The first fix padded INSIDE the colour codes, which cured the cells
# mindForge writes itself and left the cells a human writes still wrong.
# Widen the field by the difference instead, so the width means what it says.
pad_to() {
  local w="$1" t="$2" vis bytes
  vis=${#t}
  bytes=$(LC_ALL=C printf '%s' "$t" | wc -c)
  printf "%-$((w + bytes - vis))s" "$t"
}

wip_stat() {
  local d="$1" f i del u out=""
  f=$(git -C "$d" diff --numstat 2>/dev/null | wc -l)
  i=$(git -C "$d" diff --numstat 2>/dev/null | awk '{a+=$1} END{print a+0}')
  del=$(git -C "$d" diff --numstat 2>/dev/null | awk '{a+=$2} END{print a+0}')
  u=$(git -C "$d" ls-files --others --exclude-standard 2>/dev/null | wc -l)
  [ "${f:-0}" -gt 0 ] && out="${f}f +${i}/-${del}"
  [ "${u:-0}" -gt 0 ] && out="${out:+$out }${u}?"
  printf '%s' "$out"
}

days_since() {
  local e; e=$(date -d "$1" +%s 2>/dev/null) || { echo "?"; return; }
  echo $(( ( $(date +%s) - e ) / 86400 ))
}

# Two questions were conflated in v0.1.0 and answered by a single tail -1:
#   when did I last work?    -> the last row, whatever kind it is
#   what did I last finish?  -> the last WRAPPED row
# Claude Desktop opens and closes sessions far more often than a terminal
# does, so the log fills with short auto rows. One tail -1 lets that churn
# bury the closeout: the v0.1.0 wrap sat 13 rows deep and "Last time" was
# rendering empty while the bullets it wanted were right there in the file.
last_session() { grep -v '^#' "$STATE/sessions.log" 2>/dev/null | grep -v '^$' | tail -1; }
last_wrapped() { awk -F'\t' '$6=="wrapped"' "$STATE/sessions.log" 2>/dev/null | tail -1; }

headline() {
  # F-33 · The notification body is headline() minus its first line, and a
  # standing rule is for the session's context, not for a launch popup that
  # the human wrote the rules for in the first place. One flag keeps the
  # popup a glance without keeping the rules out of the handoff.
  local want_always=1
  [ "${1:-}" = "--no-rules" ] && want_always=0
  printf '%s%s%s · %s\n' "$B" "$(date '+%a %Y-%m-%d')" "$O" "$(date '+%H:%M')"
  local L; L=$(last_session)
  if [ -n "$L" ]; then
    local d f n; d=$(cut -f1 <<<"$L"); f=$(cut -f4 <<<"$L"); n=$(days_since "$d")
    case $n in 0) when="today";; 1) when="yesterday";; *) when="$n days ago";; esac
    printf 'last session: %s (%s) — %s\n' "$when" "$(cut -f2 <<<"$L")–$(cut -f3 <<<"$L")" "$f"
    # W-8d · Ask the human; do not reconstruct. The earlier conversation is
    # not this one, and guessing what it did is how a log starts to lie.
    # #27 · What the last closeout measured as unfinished, dated, so it is
    # read as "open at that wrap", not as a claim about right now.
    local W7; W7=$(last_wrapped | cut -sf7)
    [ -n "$W7" ] && printf '  %s! open at the last wrap (%s): %s%s\n' "$Y" "$(last_wrapped | cut -f1)" "$W7" "$O"
    [ "$f" = "(not wrapped)" ] && \
      printf '  %s→ ask the human what that session did, then: mindforge wrap --previous "<focus>" "<b1>|<b2>"%s\n' "$D" "$O"
  else
    printf '%slast session: none recorded%s\n' "$D" "$O"
  fi
  # rot line
  # "clean" must mean SAFE, not merely committed. A repo with no remote is
  # one disk failure from gone, and the old wording called it clean.
  local dirty=0 unpushed=0 noremote=0 n=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue; n=$((n+1))
    [ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ] && dirty=$((dirty+1))
    local a; a=$(git -C "$d" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
    [ "${a:-0}" -gt 0 ] 2>/dev/null && unpushed=$((unpushed+1))
    git -C "$d" remote 2>/dev/null | grep -q . || noremote=$((noremote+1))
  done < <(all_repos)
  if [ $dirty -eq 0 ] && [ $unpushed -eq 0 ] && [ $noremote -eq 0 ]; then
    printf '%s%d repos clean · nothing unpushed%s' "$G" "$n" "$O"
  else
    printf '%s%d dirty · %d unpushed' "$Y" "$dirty" "$unpushed"
    [ $noremote -gt 0 ] && printf ' · %d with nowhere to push' "$noremote"
    printf '%s' "$O"
  fi
  if [ -f "$REMOTE" ]; then
    printf ' · remote data %s min old' "$(( ( $(date +%s) - $(stat -c %Y "$REMOTE") ) / 60 ))"
  else
    printf ' · %sno remote cache (Stage 2)%s' "$D" "$O"
  fi
  echo
  # F-13 · The in-flight note must reach the INJECTED briefing, not just the
  # full brief. The hook injects headline() only, so the one line whose whole
  # purpose is telling the next instance what to do next was the one line the
  # next instance never saw. Truncated: this goes into context and into a
  # notification body, and `mindforge brief` carries the full text.
  if [ -r "$STATE/wip.md" ]; then
    local w ts; ts=$(cut -f1 "$STATE/wip.md"); w=$(cut -f2 "$STATE/wip.md")
    # F-16 · The cap was 200 chars and the cut was silent. On 2026-08-30 a
    # 543-char note delivered 200, and the 343 characters dropped carried every
    # clause saying the work was NOT finished -- the parity ruling among them.
    # A fresh instance read the surviving "fixes written, not committed" as an
    # invitation and proposed committing and tagging, the one action the note
    # existed to forbid. Silent truncation does not lose detail here, it
    # INVERTS the instruction. So: a far larger budget, and a note that is cut
    # says so in words, where the reader cannot mistake it for the whole note.
    # F-27 · Stamp it. Undated and sitting directly under "last session:
    # yesterday", the note gets read as yesterday's -- which is what happened.
    if [ ${#w} -gt 900 ]; then
      w="${w:0:900} [TRUNCATED at 900 of ${#w} chars -- run \`mindforge brief\` for the rest]"
    fi
    printf '%sin flight%s (%s): %s\n' "$Y" "$O" "$ts" "$w"
  fi
  # F-9 · Scope stated, not remembered. A persona scoped to two projects
  # leaked into an unrelated one twice in three weeks -- both times in
  # sessions that HAD the rule loaded. A rule that breaks while loaded is a
  # design problem, so print the boundary instead of trusting recall.
  # F-18 · Readable is not the same as meaningful. head -1 took whatever the
  # first line was, so an empty file printed a bare "scope:" with no scope,
  # and persona.example copied verbatim -- which its own first line tells you
  # to do -- announced "scope: # Copy to $MINDFORGE_STATE/persona.txt".
  # The line whose whole job is stating the boundary stated a comment. Skip
  # comments and blanks, and print nothing rather than something empty.
  if [ -r "$STATE/persona.txt" ]; then
    local sc; sc=$(grep -vE '^[[:space:]]*(#|$)' "$STATE/persona.txt" 2>/dev/null | head -1)
    [ -n "$sc" ] && printf '%sscope:%s %s\n' "$D" "$O" "$sc"
  fi
  [ $want_always -eq 1 ] && always_rules
  return 0
}

full() {
  local queue_missing=0
  headline; echo
  local W; W=$(last_wrapped)
  if [ -n "$W" ]; then
    printf '%sLast time%s · %s\n' "$B" "$O" "$(cut -f1 <<<"$W")"
    printf '  %s\n' "$(cut -f4 <<<"$W")"
    cut -f5 <<<"$W" | tr '|' '\n' | grep -v '^$' | sed 's/^/    · /'
    echo
  fi

  if [ -r "$STATE/wip.md" ]; then
    printf '%sIn flight%s · %s\n' "$Y" "$O" "$(cut -f1 "$STATE/wip.md")"
    printf '  %s\n\n' "$(cut -f2 "$STATE/wip.md")"
  fi

  printf '%sProjects%s\n' "$B" "$O"
  # F-20 · A missing queue.md leaked a raw shell error into the middle of this
  # table -- and exit stayed 0, so it read as a rendered brief with noise in it.
  # This is the FIRST-RUN path: mindForge shipped no queue template, so every
  # new user met it. Say what is missing and how to fix it, and skip the table.
  if [ ! -r "$STATE/queue.md" ]; then
    printf '  %sno queue.md yet -- copy templates/queue.md.template to %s/queue.md%s\n\n' \
      "$D" "$STATE" "$O"
    queue_missing=1
  else
  printf '  %-20s %-10s %-42s %s\n' "REPO" "LAST" "NEXT" "STATE"
  while IFS=$'\t' read -r proj next impact block ref; do
    case "$proj" in \#*|@*|"") continue;; esac   # @ lines are directives, not repos
    : "${ref:-}"                                  # column 5 is R8's business
    local d="" g="" last="-" st="${G}clean${O}"
    d=$(proj_dir "$proj") && g=$(governing_repo "$d")
    if [ -n "$g" ]; then
      last=$(git -C "$g" log -1 --format=%cs 2>/dev/null)
      if [ -n "$(git -C "$g" status --porcelain 2>/dev/null)" ]; then
        st="${Y}dirty${O} ${D}$(wip_stat "$g")${O}"
      fi
    # F-19 · st defaults to clean above, and this branch used to set only
    # last -- so a project named in the queue but absent from disk was
    # reported as clean, in green. Absent is not clean; it is unknown.
    # F-32 · printf field widths count BYTES, not visible characters, so a cell
    # carrying colour codes eats its own padding -- ${D}no repo${O} is 15 bytes
    # for 7 visible, the %-10s below adds nothing, and every column to the right
    # shifts left by three. Pad inside the colour so the field sees 10 visible.
    else last="${D}$(printf '%-10s' 'no repo')${O}"; st="${R}absent${O}"; fi
    # A dependency is extra information, not a replacement. v0.1.0 assigned
    # over $st here, so a dirty repo that also had a dependency printed
    # "waits" and its dirt never surfaced anywhere in the table.
    case "$block" in
      waits:*)  st="$st ${Y}waits${O}" ;;
      blocks:*) st="$st ${G}clears${O}" ;;
    esac
    printf '  %s %-10s %s %b\n' "$(pad_to 20 "$proj")" "$last" "$(pad_to 42 "${next:0:42}")" "$st"
  done < <(queue_lines)
  fi
  echo

  if [ "${queue_missing:-0}" -eq 0 ]; then
  printf '%sRecommended first%s\n' "$B" "$O"
  awk -F'\t' '
      # Comma-joined names share a tier: "nog,store/two kognog" ranks nog and
      # store/two equally, above kognog. Strict order could not express two
      # things that are both first -- and a launch date does not wait its turn.
      /^@priority/ { n=split($0,P," ")
                     for(i=2;i<=n;i++) { m=split(P[i],Q,",")
                       for(j=1;j<=m;j++) rank[Q[j]]=n-i+1 }
                     next }
      /^#/ || NF<4 { next }
      # Project priority DOMINATES (x10): nog outranks any Forge app,
      # so no amount of impact or unblocking reorders across projects.
      # Impact and blocks/waits order things within that.
      { w = (rank[$1] ? rank[$1] : 0) * 10 + $3;
        if ($4 ~ /^blocks:/) w += 2; if ($4 ~ /^waits:/) w -= 5;
        print w"\t"$1"\t"$2"\t"$4 }' <(queue_lines) \
    | sort -rn | head -2 \
    | while IFS=$'\t' read -r i p n b; do
        printf '  %s%s%s — %s\n' "$B" "$p" "$O" "$n"
        case "$b" in
          blocks:*) printf '    %sunblocks %s — do this first%s\n' "$Y" "${b#blocks:}" "$O" ;;
          waits:*)  printf '    %swaiting on %s%s\n' "$Y" "${b#waits:}" "$O" ;;
        esac
      done
  fi
  echo

  printf '%sState%s\n' "$B" "$O"
  printf '  memory     %s files, newest %s\n' \
    "$(ls "$MEM"/*.md 2>/dev/null | wc -l)" \
    "$(date -r "$(ls -t "$MEM"/*.md 2>/dev/null | head -1)" '+%Y-%m-%d %H:%M' 2>/dev/null)"
  printf '  L0         %s/60 lines\n' "$(grep -c '' "$HOME/.claude/CLAUDE.md" 2>/dev/null || echo 0)"
  printf '  L1         %s domains\n' "$(ls "$HOME"/.claude/rules/*.md 2>/dev/null | wc -l)"
  if [ -n "$VAULT" ] && [ -d "$VAULT" ]; then
    printf '  vault      newest %s\n' \
      "$(find "$VAULT" -name '*.md' -printf '%TY-%Tm-%Td %f\n' 2>/dev/null | sort -r | head -1)"
  fi
  echo
  printf '%sRot check%s\n' "$B" "$O"; rot; echo
  printf '%s%s%s\n' "$D" "$(rule_of_the_day)" "$O"
}

rule_of_the_day() {
  # User content -- lives in state, never in this published file.
  local f="$STATE/rules.txt"
  [ -r "$f" ] || return 0
  mapfile -t rules < <(grep -vE '^[[:space:]]*(#|$)' "$f")
  [ "${#rules[@]}" -eq 0 ] && return 0
  echo "${rules[$(( $(date +%j) % ${#rules[@]} ))]}"
}

# F-33 · A standing rule must arrive without anyone having to ask for it.
# rules.txt could not do that job twice over: it prints only in the FULL
# brief, which the injected handoff does not include, and even there it shows
# ONE rule per day -- with 7 rules on file, any given rule was absent 6 days
# in 7. Found the way findings should be found: the human asked for the same
# thing twice in one day, on two surfaces, and the one surface built for
# exactly this held nothing and would have shown a different rule anyway.
# Rotation is the right shape for a nudge and the wrong shape for a standing
# order, so standing orders get their own file and EVERY line of it goes into
# EVERY handoff. The cap announces itself in the handoff on purpose: dropping
# a standing rule in silence is the precise failure this fix exists to end.
always_rules() {
  local f="$STATE/always.txt"
  [ -r "$f" ] || return 0
  local max="${MINDFORGE_ALWAYS_MAX:-10}"
  case $max in ''|*[!0-9]*) max=10 ;; esac
  local -a a; mapfile -t a < <(grep -vE '^[[:space:]]*(#|$)' "$f")
  [ "${#a[@]}" -eq 0 ] && return 0
  local i=0 r
  for r in "${a[@]}"; do
    [ "$i" -ge "$max" ] && break
    printf '%salways:%s %s\n' "$D" "$O" "$r"
    i=$((i+1))
  done
  [ "${#a[@]}" -gt "$max" ] && printf \
    '%salways: [%d MORE ALWAYS-ON RULES NOT SHOWN -- trim always.txt or raise MINDFORGE_ALWAYS_MAX]%s\n' \
    "$Y" "$(( ${#a[@]} - max ))" "$O"
  return 0
}



# --------------------------------------------------------------------- rot --
# Rot is silent by definition: nothing breaks, so nothing tells you.
# R1-R7 are local and fast. R8 is the one exception -- it asks a real tracker,
# because the fact it needs (is this issue still open?) does not exist on this
# machine. It is cached and time-boxed so `brief` stays instant, and it reports
# NOT VERIFIED rather than silence when it cannot reach the tracker.
# Each finding prints as "CODE<TAB>message".

# Derive owner/repo from the project's own git remote rather than a table.
# A hardcoded map is one more thing that rots -- and it would have been wrong
# on day one: the directory is `kognog`, the repository is `KognogOS`.
queue_repo() {
  local d; d=$(proj_dir "$1") || return 1
  local u; u=$(git -C "$d" remote get-url origin 2>/dev/null) || return 1
  local r
  case "$u" in
    https://github.com/*) r=${u#https://github.com/} ;;
    *github.com:*)        r=${u##*github.com:} ;;   # ssh form, any user
    *) return 1 ;;                       # AUR and other non-GitHub remotes
  esac
  printf '%s' "${r%.git}"
}

# OPEN | CLOSED | UNKNOWN for one issue, cached.
# UNKNOWN IS NEVER CACHED. A network blip must not harden into a durable
# answer -- that is how a check starts lying quietly, which is the exact
# failure this whole rule exists to catch.
QUEUE_TTL="${MINDFORGE_QUEUE_TTL:-21600}"     # 6h; OPEN and CLOSED both expire
queue_ref_state() {
  local repo="$1" num="$2" cache="$STATE/queue-refs.cache" now hit st
  now=$(date +%s)
  if [ -r "$cache" ]; then
    hit=$(awk -F'\t' -v r="$repo" -v n="$num" -v now="$now" -v ttl="$QUEUE_TTL" \
          '$1==r && $2==n && (now-$4) < ttl { v=$3 } END { if (v) print v }' "$cache")
    [ -n "${hit:-}" ] && { printf '%s' "$hit"; return 0; }
  fi
  st=$(GH_PAGER=cat timeout 8 gh issue view "$num" -R "$repo" \
         --json state -q .state 2>/dev/null)
  case "${st:-}" in
    OPEN|CLOSED) printf '%s\t%s\t%s\t%s\n' "$repo" "$num" "$st" "$now" >> "$cache" ;;
    *) st=UNKNOWN ;;
  esac
  printf '%s' "$st"
}

rot_checks() {
  # R1 · PKGBUILD version vs the repo's latest tag
  local root
  for root in $(proj_roots); do
  for pb in "$root"/*/PKGBUILD; do
    [ -f "$pb" ] || continue
    local d=${pb%/PKGBUILD} name; name=$(basename "$d")
    [ -d "$d/.git" ] || continue
    local pv tv
    pv=$(grep -m1 '^pkgver=' "$pb" | cut -d= -f2)
    tv=$(git -C "$d" describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
    [ -n "$tv" ] && [ "$pv" != "$tv" ] && \
      printf 'R1\tPKGBUILD in %s says %s, latest tag is %s\n' "$name" "$pv" "$tv"
  done
  done

  # R2 · repo-root PKGBUILD vs its AUR twin -- CONTENT, not version.
  # Both files said 1.3.1 on 2026-08-29 while one fetched an unsigned tarball.
  for root in $(proj_roots); do
  for pb in "$root"/*/PKGBUILD; do
    [ -f "$pb" ] || continue
    local d=${pb%/PKGBUILD} name; name=$(basename "$d")
    for twin in "$root/aur-$name/PKGBUILD" "$root/aur-$name-remote/PKGBUILD"; do
      [ -f "$twin" ] || continue
      for key in source sha256sums validpgpkeys; do
        local a b
        a=$(grep -c "^$key" "$pb"); b=$(grep -c "^$key" "$twin")
        if [ "$a" != "$b" ]; then
          printf 'R2\t%s root PKGBUILD diverges from AUR on %s\n' "$name" "$key"
        elif [ "$key" = source ] && \
             ! diff -q <(grep -A2 '^source' "$pb") <(grep -A2 '^source' "$twin") >/dev/null; then
          printf 'R2\t%s root PKGBUILD source differs from AUR\n' "$name"
        fi
      done
      break
    done
  done
  done

  # R3 · uncommitted or unpushed work
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    local n; n=$(basename "$d")
    local a; a=$(git -C "$d" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
    [ "${a:-0}" -gt 0 ] 2>/dev/null && printf 'R3\t%s has %s unpushed commit(s)\n' "$n" "$a"
    git -C "$d" remote 2>/dev/null | grep -q . || \
      printf 'R3\t%s has no remote -- it exists on this machine only\n' "$n"
  done < <(all_repos)

  # R4 · memory index out of step with the files it indexes
  if [ -d "$MEM" ]; then
    local files idx
    # Name the orphans rather than comparing counts: an index line can carry
    # more than one link, so a count comparison over-reports.
    local orphans=""
    for f in "$MEM"/*.md; do
      local b; b=$(basename "$f")
      case "$b" in MEMORY.md|archive_index_*) continue;; esac
      grep -qF "($b)" "$MEM/MEMORY.md" 2>/dev/null || orphans="$orphans $b"
    done
    [ -n "$orphans" ] && \
      printf 'R4\tmemory file(s) missing from MEMORY.md:%s\n' "$orphans"
  fi

  # R5 · L0 over budget -- dilution looks exactly like drift
  local l0; l0=$(grep -c '' "$HOME/.claude/CLAUDE.md" 2>/dev/null || echo 0)
  [ "$l0" -gt 60 ] && printf 'R5\tL0 is %s lines, over the 60-line budget\n' "$l0"

  # R6 · queue points at a project that is not there
  # F-20 · guarded: an absent queue.md is a first-run state, not a crash site.
  if [ -r "$STATE/queue.md" ]; then
    while IFS=$'\t' read -r proj _; do
      case "$proj" in \#*|@*|"") continue;; esac
      proj_dir "$proj" >/dev/null || printf 'R6\tqueue names %s, which is under none of %s\n' "$proj" "$PROJECTS"
    done < <(queue_lines)
  fi

  # R8 · the queue points at work that is already finished.
  # R6 above asks whether the PROJECT exists -- the only part of a queue line
  # that was never going to go wrong. Nothing asked whether the TASK was still
  # open, so nog's line sat on a closed issue for 16 days while the brief
  # opened with it every session and the rot check said "nothing rotting".
  #
  # The queue cannot be generated: no tool can infer what the maintainer decided
  # to do next. So it stays hand-written and becomes CHECKABLE instead -- column
  # 5 carries the reference, and this rule holds it against the real tracker.
  # Ruled 2026-09-16.
  if [ -r "$STATE/queue.md" ]; then
    local have_gh=1
    command -v gh >/dev/null 2>&1 || have_gh=0
    local checked=0
    while IFS=$'\t' read -r proj next impact block ref; do
      case "$proj" in \#*|@*|"") continue;; esac
      : "${next:-}" "${impact:-}" "${block:-}"
      # "-" is a deliberate opt-out: milestone work with no single issue.
      # EMPTY is not -- a row that simply forgot the column must be visible,
      # or the rule quietly stops covering whatever was added last.
      case "${ref:-}" in
        '-') continue ;;
        '')  printf 'R8\tqueue row for %s has no reference in column 5 -- it cannot be checked\n' "$proj"
             continue ;;
      esac
      if [ "$have_gh" -eq 0 ]; then checked=1; continue; fi
      local repo num state
      repo=$(queue_repo "$proj") || repo=""
      if [ -z "$repo" ]; then
        printf 'R8\t%s has no GitHub remote, so %s cannot be checked\n' "$proj" "$ref"
        continue
      fi
      num=${ref#\#}
      state=$(queue_ref_state "$repo" "$num")
      case "$state" in
        CLOSED)  printf 'R8\tqueue says %s is next on %s, but %s is CLOSED\n' "$proj" "$ref" "$ref" ;;
        UNKNOWN) printf 'R8\tcould not reach the tracker for %s %s -- NOT verified\n' "$proj" "$ref" ;;
      esac
    done < <(queue_lines)
    # Said once for the whole queue, not once per row.
    [ "$checked" -eq 1 ] && \
      printf 'R8\tgh is not on PATH -- no queue entry was checked\n'
  fi

  # R7 · the index is STALE, not merely incomplete.
  # R4 catches a memory file with no index line at all. It does not catch an
  # index line that contradicts the file it points at -- which is the failure
  # that actually bit: a fresh session read the one-line index, reported it as
  # the file's contents, and stated the opposite of what the file said.
  # Proxy: any memory file written more recently than MEMORY.md itself.
  if [ -d "$MEM" ] && [ -r "$MEM/MEMORY.md" ]; then
    local idx_age stale=""
    idx_age=$(stat -c %Y "$MEM/MEMORY.md")
    for f in "$MEM"/*.md; do
      local b; b=$(basename "$f")
      case "$b" in MEMORY.md|archive_index_*) continue;; esac
      [ "$(stat -c %Y "$f")" -gt "$idx_age" ] && stale="$stale $b"
    done
    [ -n "$stale" ] && \
      printf 'R7\tMEMORY.md older than the file(s) it indexes:%s\n' "$stale"
  fi

  # R9 · the index is OVER BUDGET, which is the quietest failure of the lot.
  # R7 catches an index that is stale. R4 catches a memory with no index line.
  # Neither catches an index too LARGE to load: past the harness limit
  # MEMORY.md is truncated on the way into context, and nothing in the session
  # says so -- the brief is then built from an unknown fraction of the index
  # and reads exactly like a complete one. On 2026-09-21 the index had been
  # ~2KB over for two sessions; the rot check said "nothing rotting" both
  # mornings, and it was caught only because a loader warning happened to be
  # visible that day. Do not rely on that warning: it is not ours.
  # The threshold is deliberately BELOW the real cap. The job is to warn while
  # there is still room to compact, not to confirm the damage after the fact.
  MEMORY_MAX="${MINDFORGE_MEMORY_MAX:-20000}"
  if [ -d "$MEM" ] && [ -r "$MEM/MEMORY.md" ]; then
    local sz; sz=$(stat -c %s "$MEM/MEMORY.md")
    [ "$sz" -gt "$MEMORY_MAX" ] && \
      printf 'R9\tMEMORY.md is %s bytes, past the %s-byte budget -- part of the index may already be silently dropped; compact it\n' \
        "$sz" "$MEMORY_MAX"
  fi
}

# Persist findings so "still broken" can be distinguished from "new today".
# Three sessions in a row promotes a finding to the top of the brief.
rot() {
  local log="$STATE/rot.log" today; today=$(date +%F)
  local found; found=$(rot_checks)
  if [ -n "$found" ]; then
    printf '%s\n' "$found" | while IFS=$'\t' read -r code msg; do
      # Append once per day per finding. brief runs the rot check on every
      # invocation, and on Desktop that is many times an hour; unguarded it
      # grew two identical lines per run -- 17 lines carrying 2 real facts.
      row=$(printf '%s\t%s\t%s' "$today" "$code" "$msg")
      grep -qxF "$row" "$log" 2>/dev/null && continue
      printf '%s\n' "$row" >> "$log"
    done
  fi
  if [ -z "$found" ]; then
    printf '  %snothing rotting%s\n' "$G" "$O"; return 0
  fi
  printf '%s\n' "$found" | while IFS=$'\t' read -r code msg; do
    # count DISTINCT days this exact finding has appeared
    local seen; seen=$(grep -F "	$code	$msg" "$log" 2>/dev/null | cut -f1 | sort -u | wc -l)
    if [ "$seen" -ge 3 ]; then
      printf '  %s%s  %s%s  %s(%s sessions -- fix it)%s\n' "$R" "$code" "$msg" "$O" "$R" "$seen" "$O"
    else
      printf '  %s%s%s  %s\n' "$Y" "$code" "$O" "$msg"
    fi
  done
}

# ---------------------------------------------------------------- closeout --
# F-7 · One mark per session, not one mark per machine.
# Claude Desktop spawns ~3 sessions per launch; with a single shared mark they
# consume each other's and the surviving conversation is left with none. The
# session id is exported to child processes, so a hook can identify itself
# without parsing stdin. `wrap` runs from the human's own shell, where that
# variable is absent -- it therefore takes the OLDEST surviving mark, which is
# the long-running session actually being worked in, not a churn sibling.
MARKS="$STATE/marks"
SID="${CLAUDE_CODE_SESSION_ID:-}"
LEGACY_MARK="$STATE/.session-start"

own_mark()    { [ -n "$SID" ] && printf '%s/%s' "$MARKS" "$SID" || printf '%s/_nosession' "$MARKS"; }

# W-8b · A mark now outlives the wrap. wrap writes the end time of its row into
# the mark as a third field instead of deleting it, so a second wrap in the
# same session REPLACES that row and keeps the real start, and session-end
# knows the session is already closed. Deleting the mark made one mistaken
# wrap permanent: the correct wrap after `wrap --help` had no start left and
# logged the session as 10:38-10:38.
mark_wrapped() { [ -n "$(cut -sf3 "$1" 2>/dev/null)" ]; }

# Which session is wrap closing? Its own, when it knows its id. From the
# human's shell: the OLDEST mark not yet wrapped (see F-7 above); failing
# that, the most recently wrapped one, so a corrected wrap still finds its row.
pick_mark() {
  if [ -n "$SID" ] && [ -r "$(own_mark)" ]; then own_mark; return 0; fi
  local m
  while IFS= read -r m; do
    mark_wrapped "$m" || { printf '%s' "$m"; return 0; }
  done < <(ls -1tr "$MARKS"/* 2>/dev/null)
  ls -1t "$MARKS"/* 2>/dev/null | head -1
}

# Marks outlive sessions that died without firing SessionEnd. Sweep anything
# older than the cutoff so pick_mark() cannot select a corpse.
sweep_marks() {
  [ -d "$MARKS" ] || return 0
  find "$MARKS" -maxdepth 1 -type f -mmin "+$(( ${MINDFORGE_MARK_TTL_H:-12} * 60 ))" -delete 2>/dev/null || true
}

# F-8 · The visible channel that actually works on both surfaces.
# /dev/tty needs a controlling terminal; Claude Desktop's hook runner has none.
# DBus needs neither -- notify-send locates /run/user/$UID/bus by itself even
# with DBUS_SESSION_BUS_ADDRESS stripped from the environment (verified on
# Plasma 2026-08-29, all three urgency levels rendered).
#
# Rate-limited on purpose: Desktop spawns roughly three sessions per launch,
# and three popups for one launch is worse than silence. Normal urgency, never
# critical -- a briefing is information, not an alarm, and a critical popup
# persists until dismissed. Every failure path is silent: a headless box, no
# daemon, no notify-send at all must never break the hook.
notify_headline() {
  command -v notify-send >/dev/null 2>&1 || return 0
  local stamp="$STATE/.last-notify" now prev; now=$(date +%s)
  if [ -r "$stamp" ]; then
    prev=$(cat "$stamp" 2>/dev/null || echo 0)
    [ $(( now - ${prev:-0} )) -lt "${MINDFORGE_NOTIFY_GAP_S:-60}" ] && return 0
  fi
  printf '%s\n' "$now" > "$stamp"
  local body
  body=$(headline --no-rules 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | tail -n +2)
  [ -n "$body" ] || return 0
  notify-send -a mindForge -i dialog-information -u normal \
    "mindForge · $(date '+%a %H:%M')" "$body" >/dev/null 2>&1 || true
}

session_start() {
  # date(1) does not interpret \t -- printf must build the row.
  mkdir -p "$MARKS"
  [ -r "$LEGACY_MARK" ] && mv -f "$LEGACY_MARK" "$(own_mark)" 2>/dev/null
  sweep_marks
  printf '%s\t%s\n' "$(date +%F)" "$(date +%H:%M)" > "$(own_mark)"
  notify_headline
  # SessionStart stdout goes into the assistant's CONTEXT, not to the screen.
  # To be visible to the human as well, write a coloured copy straight to the
  # terminal. Silently skipped when there is no tty (SDK, CI, print mode).
  # -w is not enough: /dev/tty can exist yet refuse to open (no controlling
  # terminal). Probe by actually opening it, and stay silent if it fails.
  # Best-effort visible copy, and terminal-only by nature. Proven absent on
  # Claude Desktop 2026-08-29: its hook runner has no controlling terminal,
  # the probe below fails, and the human sees nothing at launch. Still
  # unproven inside a Claude Code terminal -- running `mindforge brief` by
  # hand does not test this path, because that is a tty by definition.
  # Parity therefore does NOT rest here. It rests on the DIRECTIVE below,
  # which reaches the model identically on both surfaces. Treat anything
  # this block prints as a bonus, never as the delivery mechanism.
  if ( : > /dev/tty ) 2>/dev/null; then
    ( FORCE_COLOUR=1 headline > /dev/tty ) 2>/dev/null || true
  fi

  # The context copy needs a DIRECTIVE, not just data. Injected context with
  # no instruction is inert: the first live test injected this briefing and
  # the session ignored it, re-deriving the same facts with seven tool calls.
  echo "<session-briefing>"
  headline
  echo "</session-briefing>"
  cat <<'DIRECTIVE'
INSTRUCTION: open your first reply with the briefing above, rendered for the
user -- they cannot see hook output. It is already accurate; do not re-derive
it with tool calls. Then answer what they actually asked.
Offer `mindforge brief` for the full picture; do not paste the full brief unasked.
DIRECTIVE
}

# F-25 · A write that fails must never report success. The state directory
# IS the continuity: a note that was not stored but reported as stored is
# worse than no note, because the next session is told the handoff exists.
# Found with the state dir read-only -- wip printed its success line and
# exited 0 having written nothing.
can_write() {
  local f="$1"
  if [ -e "$f" ]; then [ -w "$f" ]; else
    local d; d=$(dirname "$f"); [ -d "$d" ] && [ -w "$d" ]
  fi
}

log_unwritable() {
  printf '%smindforge: cannot write %s -- row NOT logged%s\n' \
    "$R" "$STATE/sessions.log" "$O" >&2
}

# Append one row. Fields: date start end focus bullets kind [open]
# The end time it wrote is left in LOGGED_END, so wrap can record it in the mark.
# The 7th field is written only when there is something in it (#27).
log_row() {
  local start_d start_t m="${4:-}"
  if [ -n "$m" ] && [ -r "$m" ]; then start_d=$(cut -f1 "$m"); start_t=$(cut -f2 "$m")
  else start_d=$(date +%F); start_t=$(date +%H:%M); fi
  can_write "$STATE/sessions.log" || { log_unwritable; return 1; }
  LOGGED_END=$(date +%H:%M)
  printf '%s\t%s\t%s\t%s\t%s\t%s%s\n' \
    "$start_d" "$start_t" "$LOGGED_END" "$1" "$2" "$3" "${5:+$'\t'$5}" >> "$STATE/sessions.log"
}

# Replace the LAST row whose date, start, end and kind match with <new row>.
# Every other byte of the log is copied untouched, into a temp file that is
# then moved into place -- a failure part-way leaves the old log whole.
#   replace_row <date> <start> <end> <kind> <new row>
# Returns 3 when no row matched (nothing written), 1 when the write failed.
replace_row() {
  local log="$STATE/sessions.log" tmp rc
  can_write "$log" && [ -w "$STATE" ] || { log_unwritable; return 1; }
  tmp=$(mktemp "$STATE/.sessions.XXXXXX") || { log_unwritable; return 1; }
  # Values go in through the environment: awk -v would rewrite any backslash
  # in a focus or bullet.
  D="$1" S="$2" E="$3" K="$4" NEW="$5" awk -F'\t' '
    { line[NR] = $0
      if ($1 == ENVIRON["D"] && $2 == ENVIRON["S"] && $3 == ENVIRON["E"] && $6 == ENVIRON["K"]) hit = NR }
    END { if (!hit) exit 3
          for (i = 1; i <= NR; i++) print (i == hit ? ENVIRON["NEW"] : line[i]) }' "$log" > "$tmp"
  rc=$?
  if [ $rc -ne 0 ]; then rm -f "$tmp"; [ $rc -eq 3 ] && return 3; log_unwritable; return 1; fi
  chmod --reference="$log" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$log" || { rm -f "$tmp"; log_unwritable; return 1; }
}

# W-8a · An option is not a focus. wrap took its first argument as the focus
# with no check, so `wrap --help` -- run by an assistant learning the syntax --
# recorded a real closeout titled "--help", deleted the in-flight note and
# spent the session mark. drift had the same hole. `--help` is answered by the
# dispatcher before any command runs; any other leading dash is refused here,
# before anything is written. A note that really starts with a dash goes
# after `--`.
bad_option() {
  printf 'mindforge %s: unknown option %s  (a note starting with "-" goes after --)\n' "$1" "$2" >&2
  exit 2
}

# #27 · A wrap must measure, not feel finished.
# Twice in one session a wrap was declared and was not: the last hour was
# missing from the logs, a count had drifted, a forbidden string had been
# committed. Each was invisible to "does this feel complete" and obvious to
# "does file X say Y". The old wrap measured one thing -- unpushed commits --
# and printed "all repos pushed", which read as nine things.
#
# Three levels, and the difference is the point:
#   !  open      a fact that makes the wrap NOT clean
#   ?  unknown   a check that could not run -- also NOT clean (#24: a check
#                that cannot measure must never read as a pass)
#   ·  info      measured and shown, but the human's call: memory and the
#                vault are written when the human decides, so their silence
#                is a fact to see, not a failure to count
# Open and unknown items are stored in the row's 7th field, so the next
# brief can say what the last closeout left behind.
CHECK_OUT="" OPEN_ITEMS="" N_OPEN=0 N_UNVER=0
c_ok()   { CHECK_OUT+="  ${G}ok${O}  $1"$'\n'; }
c_open() { N_OPEN=$((N_OPEN+1)); OPEN_ITEMS+="${OPEN_ITEMS:+; }$1"; CHECK_OUT+="  ${Y}!${O}   $1"$'\n'; }
c_unk()  { N_UNVER=$((N_UNVER+1)); OPEN_ITEMS+="${OPEN_ITEMS:+; }not verified: $1"; CHECK_OUT+="  ${R}?${O}   $1 -- NOT verified"$'\n'; }
c_info() { CHECK_OUT+="  ${D}·   $1${O}"$'\n'; }

# wrap_checks <start date> <start time> -- both empty when the start is unknown
wrap_checks() {
  local since=""; [ -n "${1:-}" ] && [ -n "${2:-}" ] && since="$1 $2"
  local d name n=0 clean=0 dirty a c t
  while IFS= read -r d; do
    [ -n "$d" ] || continue; n=$((n+1)); name=$(basename "$d")
    if ! git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then c_unk "$name: not readable as a git repo"; continue; fi
    local before=$((N_OPEN+N_UNVER))
    dirty=$(git -C "$d" status --porcelain 2>/dev/null | grep -c .)
    [ "$dirty" -gt 0 ] && c_open "$name: $dirty uncommitted file(s)"
    if ! git -C "$d" remote 2>/dev/null | grep -q .; then
      c_open "$name: no remote -- it exists on this machine only"
    elif a=$(git -C "$d" rev-list --count @{u}..HEAD 2>/dev/null); then
      [ "$a" -gt 0 ] && c_open "$name: $a unpushed commit(s)"
    else
      c_unk "$name: no upstream branch, so unpushed work cannot be counted"
    fi
    # The project's TODO.md is the handoff between sessions. Work committed
    # this session with the list untouched is the "last thing done" gap.
    if [ -n "$since" ] && [ -f "$d/TODO.md" ]; then
      c=$(git -C "$d" log --since="$since" --format=%H 2>/dev/null | grep -c .)
      t=$( { git -C "$d" log --since="$since" --format= --name-only -- TODO.md 2>/dev/null
             git -C "$d" status --porcelain -- TODO.md 2>/dev/null; } | grep -c .)
      [ "$c" -gt 0 ] && [ "$t" -eq 0 ] && c_open "$name: $c commit(s) this session, TODO.md not updated"
    fi
    [ $((N_OPEN+N_UNVER)) -eq "$before" ] && clean=$((clean+1))
  done < <(all_repos)
  [ "$n" -gt 0 ] && [ "$clean" -eq "$n" ] && c_ok "$n repos committed and pushed${since:+, TODO.md current where there is one}"
  [ "$n" -gt 0 ] && [ "$clean" -lt "$n" ] && [ "$clean" -gt 0 ] && c_ok "$clean other repo(s) committed and pushed"
  [ "$n" -eq 0 ] && c_unk "no repos found under $PROJECTS"
  [ -z "$since" ] && c_unk "session start unknown -- TODO.md, memory and vault coverage"

  if [ -n "$since" ]; then
    if [ -d "$MEM" ]; then
      c=$(find "$MEM" -maxdepth 1 -type f -newermt "$since" 2>/dev/null | grep -c .)
      if [ "$c" -gt 0 ]; then c_info "memory: $c file(s) changed this session"
      else c_info "memory: nothing changed this session -- if what is true changed, ask whether to record it"; fi
    else
      c_unk "memory folder not found at $MEM"
    fi
    if [ -n "$VAULT" ]; then
      if [ -d "$VAULT" ]; then
        c=$(find "$VAULT" -type f -newermt "$since" 2>/dev/null | grep -c .)
        c_info "vault: $c file(s) changed this session"
      else
        c_unk "vault folder not found at $VAULT"
      fi
    fi
  fi
  [ -r "$STATE/wip.md" ] && c_info "in-flight note cleared by this wrap: $(cut -f2 "$STATE/wip.md")"
  return 0
}

# The deliberate closeout. Called with a focus and pipe-separated bullets.
wrap() {
  local previous=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --previous) previous=1; shift ;;
      -h|--help)  usage; exit 0 ;;
      --) shift; break ;;
      -*) bad_option wrap "$1" ;;
      *)  break ;;
    esac
  done
  local focus="${1:-}" bullets="${2:-}"
  [ -z "$focus" ] && { echo "usage: mindforge wrap [--previous] \"<focus>\" \"<b1>|<b2>|...\"" >&2; exit 2; }
  [ $previous -eq 1 ] && { wrap_previous "$focus" "$bullets"; return; }
  local MK; MK=$(pick_mark)
  # F-25 · Order matters as much as the guard. This deleted the in-flight note
  # first and dropped the mark unconditionally, so a log write that failed
  # destroyed the note AND the session start while still printing "wrapped" --
  # three losses reported as a success. Log first; destroy only what the log
  # has actually replaced.
  # Measure before writing: the row carries what the checks left open.
  if [ -n "$MK" ] && [ -r "$MK" ]; then wrap_checks "$(cut -f1 "$MK")" "$(cut -f2 "$MK")"
  else wrap_checks "" ""; fi
  local replaced=0
  if [ -n "$MK" ] && mark_wrapped "$MK"; then
    # W-8b · This session was wrapped already: correct that row, do not add one.
    local sd st old_end rc
    sd=$(cut -f1 "$MK"); st=$(cut -f2 "$MK"); old_end=$(cut -f3 "$MK")
    LOGGED_END=$(date +%H:%M)
    replace_row "$sd" "$st" "$old_end" "wrapped" \
      "$(printf '%s\t%s\t%s\t%s\t%s\t%s%s' "$sd" "$st" "$LOGGED_END" "$focus" "$bullets" "wrapped" "${OPEN_ITEMS:+$'\t'$OPEN_ITEMS}")"
    rc=$?
    if [ $rc -eq 0 ]; then replaced=1
    elif [ $rc -eq 3 ]; then
      # The earlier row is gone (dropped with `mindforge log --drop-last`, or
      # edited out by hand). Nothing to correct -- record this one as new.
      log_row "$focus" "$bullets" "wrapped" "$MK" "$OPEN_ITEMS" || rc=1
    fi
    [ $rc -eq 1 ] && { printf '%s  closeout NOT recorded -- nothing was cleared%s\n' "$R" "$O" >&2; return 1; }
  elif ! log_row "$focus" "$bullets" "wrapped" "$MK" "$OPEN_ITEMS"; then
    printf '%s  closeout NOT recorded -- nothing was cleared%s\n' "$R" "$O" >&2
    return 1
  fi
  rm -f "$STATE/wip.md"          # wrapped work is no longer in flight
  # The mark stays, stamped with this row's end, until session-end spends it.
  [ -n "$MK" ] && [ -r "$MK" ] && \
    printf '%s\t%s\t%s\n' "$(cut -f1 "$MK")" "$(cut -f2 "$MK")" "$LOGGED_END" > "$MK"
  rm -f "$LEGACY_MARK"
  if [ $replaced -eq 1 ]; then
    printf '%swrapped:%s %s  %s(replaces this session'"'"'s earlier wrap)%s\n' "$G" "$O" "$focus" "$D" "$O"
  else
    printf '%swrapped:%s %s\n' "$G" "$O" "$focus"
  fi
  printf '%s\n' "$bullets" | tr '|' '\n' | sed 's/^/  · /'
  printf '%s' "$CHECK_OUT"
  # F-17 · Open items are output, not an error: wrap exits 0 either way. It
  # used to exit 1 whenever it warned, which broke && chains and would mark a
  # SessionEnd hook failed exactly when there WAS something to see.
  if [ $((N_OPEN+N_UNVER)) -eq 0 ]; then
    printf '%swrap clean%s -- every check above passed\n' "$G" "$O"
  else
    printf '%swrap NOT clean%s -- %s open, %s not verified. Stored with the row; the next brief shows them.\n' \
      "$Y" "$O" "$N_OPEN" "$N_UNVER"
  fi
  return 0
}

# The floor. Runs from the SessionEnd hook whether or not wrap was called.
# Desktop churns sessions on its own -- 14 in one afternoon here, four of
# them stamped 18:02-18:02. A session that recorded nothing is not a session,
# and logging it only buries the ones that mattered. Below the floor the mark
# is cleared and no row is written. If the elapsed time cannot be measured,
# the row is written: an unmeasurable session is not a proven-empty one.
MIN_SESSION_MIN="${MINDFORGE_MIN_SESSION_MIN:-2}"

session_end() {
  local MK; MK=$(own_mark)
  [ -r "$MK" ] || exit 0            # never started, or swept
  # Wrapped already: the row exists, so the mark is simply spent.
  mark_wrapped "$MK" && { rm -f "$MK"; exit 0; }
  local sd st epoch
  sd=$(cut -f1 "$MK"); st=$(cut -f2 "$MK")
  epoch=$(date -d "$sd $st" +%s 2>/dev/null || true)
  # F-25 · Keep the mark when a row that was meant to be written was not.
  # Below the floor nothing is logged and the mark is spent as designed; a
  # FAILED write is different, and dropping the mark there loses the session
  # start with nothing in the log to show for it.
  local logged=1
  if [ -z "${epoch:-}" ]; then
    # Unmeasurable, so record it -- but never propagate the bad field into
    # the log, where it would break every future headline.
    printf '%s\t%s\n' "$(date +%F)" "$(date +%H:%M)" > "$MK"
    log_row "(not wrapped)" "" "auto" "$MK" || logged=0
  elif [ $(( ( $(date +%s) - epoch ) / 60 )) -ge "$MIN_SESSION_MIN" ]; then
    log_row "(not wrapped)" "" "auto" "$MK" || logged=0
  fi
  [ "$logged" -eq 1 ] && rm -f "$MK"
}

# W-8d · A conversation that ended without a wrap left a "(not wrapped)" row
# that nothing could ever close: wrap only appends, and it belongs to the
# CURRENT session. `wrap --previous` closes the most recent such row in place,
# keeping its own date and times. It touches neither the in-flight note nor
# any mark -- the session running now is still open. What the earlier session
# did is the human's to say; the brief asks, it does not reconstruct.
wrap_previous() {
  local row
  row=$(awk -F'\t' '!/^#/ && $4 == "(not wrapped)" && $6 == "auto"' "$STATE/sessions.log" 2>/dev/null | tail -1)
  if [ -z "$row" ]; then
    echo "mindforge wrap --previous: no session is waiting for a wrap -- nothing written" >&2
    return 1
  fi
  local d s e
  d=$(cut -f1 <<<"$row"); s=$(cut -f2 <<<"$row"); e=$(cut -f3 <<<"$row")
  replace_row "$d" "$s" "$e" "auto" \
    "$(printf '%s\t%s\t%s\t%s\t%s\t%s' "$d" "$s" "$e" "$1" "$2" "wrapped")" \
    || { printf '%s  closeout NOT recorded%s\n' "$R" "$O" >&2; return 1; }
  printf '%swrapped earlier session:%s %s %s–%s · %s\n' "$G" "$O" "$d" "$s" "$e" "$1"
  printf '%s\n' "$2" | tr '|' '\n' | grep -v '^$' | sed 's/^/  · /'
  return 0
}

# W-8c · Repairing the log is a command mindForge owns, not a hand edit.
# The hand edit needed the human every time: an assistant's auto mode rightly
# refuses to rewrite a log, so a bad row -- like the "--help" wrap -- stayed
# until someone typed the fix. --drop-last removes exactly one row, the last,
# prints it, and keeps a timestamped copy of the log from before.
log_cmd() {
  local log="$STATE/sessions.log"
  case "${1:-}" in
    "")
      grep -v '^#' "$log" 2>/dev/null | grep -v '^$' | tail -"${MINDFORGE_LOG_ROWS:-10}" \
        | awk -F'\t' '{ printf "%s %s–%s  %-7s %s\n", $1, $2, $3, $6, $4 }'
      return 0 ;;
    --drop-last) ;;
    *) bad_option log "$1" ;;
  esac
  local last n
  last=$(grep -v '^#' "$log" 2>/dev/null | grep -v '^$' | tail -1)
  [ -n "$last" ] || { echo "mindforge log: the log has no rows -- nothing dropped" >&2; return 1; }
  can_write "$log" && [ -w "$STATE" ] || { log_unwritable; return 1; }
  local bak; bak="$log.bak-$(date +%Y%m%d-%H%M%S)"
  cp -p "$log" "$bak" || { echo "mindforge log: could not save a backup -- nothing dropped" >&2; return 1; }
  local tmp; tmp=$(mktemp "$STATE/.sessions.XXXXXX") || { log_unwritable; return 1; }
  # The last non-comment, non-blank line, found by number so an identical
  # earlier row survives.
  n=$(grep -nv '^#' "$log" | grep -v '^[0-9]*:$' | tail -1 | cut -d: -f1)
  sed "${n}d" "$log" > "$tmp" || { rm -f "$tmp"; log_unwritable; return 1; }
  chmod --reference="$log" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$log" || { rm -f "$tmp"; log_unwritable; return 1; }
  # A mark that points at the dropped row is no longer wrapped: without this,
  # session-end would treat the session as closed and log nothing at all.
  local m d s e
  d=$(cut -f1 <<<"$last"); s=$(cut -f2 <<<"$last"); e=$(cut -f3 <<<"$last")
  for m in "$MARKS"/*; do
    [ -r "$m" ] && mark_wrapped "$m" || continue
    [ "$(cut -f1 "$m")" = "$d" ] && [ "$(cut -f2 "$m")" = "$s" ] && [ "$(cut -f3 "$m")" = "$e" ] \
      && printf '%s\t%s\n' "$d" "$s" > "$m"
  done
  printf 'dropped: %s\n' "$(awk -F'\t' '{ printf "%s %s–%s  %s  %s", $1, $2, $3, $6, $4 }' <<<"$last")"
  printf '%sbackup:  %s%s\n' "$D" "$bak" "$O"
}

# F-12 · The mid-session sibling of wrap.
# git can show that 89 lines changed. It cannot say "written, tested, pending
# release" -- and that sentence is the whole difference between a fresh
# session resuming the work and offering to redo it. wrap records what landed;
# wip records what is still in the air. Cleared automatically by wrap, because
# work that has been wrapped is by definition no longer in flight.
wip() {
  case "${1:-}" in
    --clear) rm -f "$STATE/wip.md"; echo "in-flight note cleared"; return 0 ;;
    --)      shift ;;
    --show)  set -- ;;
    -*)      bad_option wip "$1" ;;
  esac
  local note="${*:-}"
  if [ -z "$note" ]; then
    [ -r "$STATE/wip.md" ] && cat "$STATE/wip.md" || echo "nothing in flight"; return 0
  fi
  if ! can_write "$STATE/wip.md"; then
    printf '%smindforge: cannot write %s -- note NOT stored%s\n' \
      "$R" "$STATE/wip.md" "$O" >&2
    return 1
  fi
  printf '%s\t%s\n' "$(date '+%Y-%m-%d %H:%M')" "$note" > "$STATE/wip.md"
  printf '%sin flight:%s %s\n' "$Y" "$O" "$note"
}

# One keystroke when drift is caught. Data beats impressions.
drift() {
  case "${1:-}" in
    --) shift ;;
    -*) bad_option drift "$1" ;;
  esac
  local note="${*:-}"
  [ -z "$note" ] && { echo "usage: mindforge drift \"<what slipped>\"" >&2; exit 2; }
  printf '%s\t%s\n' "$(date '+%Y-%m-%d %H:%M')" "$note" >> "$STATE/drift.log"
  printf '%slogged.%s %s drift note(s) so far.\n' "$Y" "$O" "$(grep -c . "$STATE/drift.log")"
}

usage() {
  cat <<'USAGE'
usage:
  mindforge brief [--headline]     what is true right now
  mindforge wip "<what is half-done>"    record work still in the air
  mindforge wip --show | --clear
  mindforge wrap "<focus>" "<b1>|<b2>"   close the session deliberately
                                         (again in the same session: corrects it)
  mindforge wrap --previous "<focus>" "<b1>|<b2>"
                                         close the last session that ended unwrapped
  mindforge drift "<what slipped>"       log a drift observation
  mindforge log [--drop-last]            recent rows / remove the last (backup kept)
  mindforge rot                          the silent-failure checks
  mindforge session-start|session-end    (called by hooks)
  mindforge --version
A note that starts with "-" goes after --, e.g. mindforge drift -- "-x ignored"
USAGE
}

# W-8a · Help is answered before any command runs, for every command, so
# asking how a command works can never be the thing that runs it.
case "${2:-}" in -h|--help) usage; exit 0 ;; esac

case "${1:-brief}" in
  -V|--version|version) printf 'mindforge %s\n' "$VERSION" ;;
  -h|--help|help) usage ;;
  brief) [ "${2:-}" = "--headline" ] && headline || full ;;
  wip)           shift; wip "$@" ;;
  rot)           rot ;;
  session-start) session_start ;;
  session-end)   session_end ;;
  wrap)          shift; wrap "$@" ;;
  drift)         shift; drift "$@" ;;
  log)           shift; log_cmd "$@" ;;
  *) usage >&2; exit 2 ;;
esac
